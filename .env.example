# CreatorOps Environment Configuration
# Core Database Settings
DATABASE_URL=postgresql://creatorops:creatorops@localhost:5433/creatorops_db

# Security & Authentication
JWT_SECRET=creatorops-super-secure-jwt-secret-key-2026-cc-project
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Settings (STORAGE_TYPE: 'local' for dev, 's3' for MinIO / S3 in prod/docker)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=creatorops-media
MINIO_SECURE=false

# AI Assistant Settings (Ollama open-source LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
